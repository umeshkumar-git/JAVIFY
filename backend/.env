# ─── Server ──────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# ─── Database ────────────────────────────────────────────────────
# PostgreSQL connection string
# Make sure PostgreSQL is running on localhost:5432
DATABASE_URL="postgresql://postgres:password@localhost:5432/javify_dev"

# ─── Authentication ──────────────────────────────────────────────
JWT_SECRET=javify-dev-secret-change-in-production-12345
JWT_REFRESH_SECRET=javify-dev-refresh-secret-change-in-production-67890
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
CORS_ORIGIN=http://localhost:5173

# ─── Email (SMTP) ────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Javify <no-reply@javify.dev>

# ─── AI Mentor ───────────────────────────────────────────────────
OPENAI_API_KEY=

# ─── Code Execution Sandbox ──────────────────────────────────────
DOCKER_RUNNER_IMAGE=openjdk:17-slim

# ─── GitHub OAuth Integration ────────────────────────────────────
# Create an OAuth App at:  https://github.com/settings/developers
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:4000/api/auth/github/callback

# Token encryption — generate with: openssl rand -base64 32
GITHUB_TOKEN_ENCRYPTION_KEY=dev-encryption-key-change-in-production
