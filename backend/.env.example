# ─── Server ──────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# ─── Database ────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:pass@localhost:5432/javify

# ─── Authentication ──────────────────────────────────────────────
JWT_SECRET=replace-with-strong-random
JWT_REFRESH_SECRET=replace-with-strong-random
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
CORS_ORIGIN=http://localhost:5173

# ─── Email (SMTP) ────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Javify <no-reply@javify.dev>

# ─── AI Mentor ───────────────────────────────────────────────────
OPENAI_API_KEY=

# ─── Code Execution Sandbox ──────────────────────────────────────
DOCKER_RUNNER_IMAGE=openjdk:17-slim

# ─── GitHub OAuth Integration ────────────────────────────────────
# Create an OAuth App at:  https://github.com/settings/developers
#   Application name:          Javify
#   Homepage URL:              http://localhost:5173
#   Authorization callback URL must match GITHUB_CALLBACK_URL below.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:4000/auth/github/callback

# Token encryption — generate with: openssl rand -base64 32
GITHUB_TOKEN_ENCRYPTION_KEY=
